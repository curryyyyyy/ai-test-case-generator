# OpenAI API Key（请替换为你自己的真实密钥）
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI / OpenAI-Compatible Base URL（官方默认可用 https://api.openai.com/v1）
# 火山方舟 Ark 请填：https://ark.cn-beijing.volces.com/api/v3
# 注意：不要填 /api/plan/v3，那是「Agent 计划模式」专用端点，
# 普通模型调用会返回 404 UnsupportedModel: does not support the agent plan feature。
OPENAI_BASE_URL=your_openai_base_url_here

# 聊天模型 ID，不填时使用代码里的默认值
# 火山方舟请填控制台里的模型 ID 或在线推理接入点 ID（ep-xxxxxx）
OPENAI_MODEL=your_chat_model_id_here

# Embedding 模型 ID，不填时使用 rag/config.py 里的 EMBEDDING_MODEL
# 火山方舟常用：doubao-embedding-large-text-240915
RAG_EMBEDDING_MODEL=your_embedding_model_id_here

# Embedding 接口地址，不填时跟随 OPENAI_BASE_URL
# 聊天走厂商专用端点（如方舟 Coding Plan 的 /api/coding/v3）时，
# embedding 只能走标准 /api/v3，需要在这里单独指定
RAG_EMBEDDING_BASE_URL=your_embedding_base_url_here

# Embedding 方案与顺序，逗号分隔，可选 remote（OpenAI 兼容接口）/ local（本地模型）
# 例：remote,local 表示远程优先、本地兜底；local 表示完全离线（不调远程）
RAG_EMBEDDING_PROVIDER=remote,local
# 本地 embedding 模型（HuggingFace 名称），使用 local 方案时必填
# 推荐中文场景：BAAI/bge-small-zh-v1.5（首次使用会下载约 100MB）
RAG_LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# API rerank（RERANK_MODE=api 或 UI 选择 api 模式时生效）
# 兼容 Cohere / Jina / 硅基流动 / vLLM 等实现了 POST {base_url}/rerank 的服务
# RERANK_API_BASE_URL=https://api.siliconflow.cn/v1
# RERANK_API_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_API_KEY=your_rerank_api_key_here（不填时复用 OPENAI_API_KEY）
